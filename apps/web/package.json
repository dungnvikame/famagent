{
  "name": "@family-ai/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts evals eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "eval": "node scripts/evaluate.mjs",
    "import-products": "node scripts/import-products.mjs",
    "verify-offers": "node scripts/verify-offers.mjs",
    "cleanup-anonymous": "node scripts/cleanup-anonymous.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "setup:auth": "node --env-file=.env.local scripts/configure-supabase-auth.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.9.0"
  }
}
