NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public). Bật cùng Auth > CAPTCHA trong Supabase (secret key đặt ở Supabase, không đặt ở đây).
# Bỏ trống = không dùng CAPTCHA (chỉ dành cho dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only: import CSV, click log /go, migration. Supabase "Connect" → Transaction pooler (port 6543).
DATABASE_URL=

# Chỉ cho script setup trên máy (không đặt trên Vercel):
# Personal access token (supabase.com/dashboard/account/tokens) để `pnpm setup:auth` cấu hình Auth; xóa token sau khi xong.
SUPABASE_ACCESS_TOKEN=
# Domain production, ví dụ https://famagent.vercel.app (không có "/" cuối).
APP_URL=

# Agent AI (chỉ server). Chỉ gọi khi người dùng bật đồng ý; thiếu cấu hình/lỗi/hết quota thì dùng quy tắc.
AI_ENABLED=false
# Thứ tự dự phòng, cách nhau dấu phẩy: gemini, groq, openrouter, openai. Bỏ trống = openai.
LLM_PROVIDERS=groq,gemini
# Gemini free tier: tạo key tại Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-flash-latest
# Groq free tier: tạo key tại console.groq.com. Có thể liệt kê nhiều model, cách nhau dấu phẩy.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Tùy chọn cho mọi provider: <TÊN>_BASE_URL (endpoint OpenAI-compatible khác mặc định),
# <TÊN>_JSON_MODE=json_schema|json_object.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
